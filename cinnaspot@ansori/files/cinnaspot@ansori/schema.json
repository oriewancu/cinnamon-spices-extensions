{
   "layout": {
      "type": "layout",
      "pages": [
         "general-tab",
         "windows-tab",
         "sysinfo-tab",
         "appearance-tab",
         "actions-tab",
         "scripts-tab"
      ],
      "general-tab": {
         "type": "page",
         "title": "General",
         "sections": [
            "general-section",
            "calc-section"
         ]
      },
      "windows-tab": {
         "type": "page",
         "title": "Windows",
         "sections": [
            "windows-section"
         ]
      },
      "sysinfo-tab": {
         "type": "page",
         "title": "System Info",
         "sections": [
            "sysinfo-section"
         ]
      },
      "appearance-tab": {
         "type": "page",
         "title": "Appearance",
         "sections": [
            "appearance-section"
         ]
      },
      "actions-tab": {
         "type": "page",
         "title": "Actions",
         "sections": [
            "actions-section"
         ]
      },
      "scripts-tab": {
         "type": "page",
         "title": "Scripts",
         "sections": [
            "scripts-section"
         ]
      },

      "general-section": {
         "type": "section",
         "title": "General Search Settings",
         "keys": [
            "keybinding",
            "custom_placeholder",
            "max_results"
         ]
      },
      "calc-section": {
         "type": "section",
         "title": "Calculator Settings",
         "keys": [
            "thousand_separator"
         ]
      },
      "windows-section": {
         "type": "section",
         "title": "Opened Windows Sidebar Settings",
         "keys": [
            "show_opened_windows",
            "max_window_results",
            "window_font_size"
         ]
      },
      "sysinfo-section": {
         "type": "section",
         "title": "System Information Sidebar Settings",
         "keys": [
            "show_system_info",
            "disk_path"
         ]
      },
      "appearance-section": {
         "type": "section",
         "title": "Theme & Font Appearance",
         "keys": [
            "theme",
            "bg_opacity",
            "result_font_size"
         ]
      },
      "actions-section": {
         "type": "section",
         "title": "System & Session Actions",
         "keys": [
            "enable_shutdown",
            "enable_logout"
         ]
      },
      "scripts-section": {
         "type": "section",
         "title": "Script Runner Settings",
         "keys": [
            "script_prefix",
            "script_paths",
            "terminal_app"
         ]
      }
   },

   "keybinding": {
      "type": "keybinding",
      "default": "<Super>space",
      "description": "Spotlight Keyboard Shortcut"
   },
   "custom_placeholder": {
      "type": "entry",
      "default": "Search apps, settings, commands, calc...",
      "description": "Search Placeholder Text"
   },
   "max_results": {
      "type": "spinbutton",
      "indent": "true",
      "default": 8,
      "min": 1,
      "max": 20,
      "step": 1,
      "units": "items",
      "description": "Max Search Results"
   },
   "show_opened_windows": {
      "type": "switch",
      "default": true,
      "description": "Show Opened Windows"
   },
   "max_window_results": {
      "type": "spinbutton",
      "indent": "true",
      "default": 5,
      "min": 1,
      "max": 20,
      "step": 1,
      "units": "items",
      "description": "Max Window Results"
   },
   "window_font_size": {
      "type": "spinbutton",
      "indent": "true",
      "default": 11,
      "min": 8,
      "max": 20,
      "step": 1,
      "units": "px",
      "description": "Opened Windows Font Size"
   },
   "show_system_info": {
      "type": "switch",
      "default": false,
      "description": "Show System Info (Right Sidebar)"
   },
   "disk_path": {
      "type": "entry",
      "default": "/",
      "description": "Disk Partition Path (e.g., / or /home)"
   },
   "theme": {
      "type": "combobox",
      "default": "dark",
      "options": {
         "Dark": "dark",
         "Light": "light"
      },
      "description": "Spotlight Theme"
   },
   "bg_opacity": {
      "type": "scale",
      "default": 95,
      "min": 10,
      "max": 100,
      "step": 1,
      "description": "Panel Background Opacity (%)"
   },
   "result_font_size": {
      "type": "spinbutton",
      "indent": "true",
      "default": 14,
      "min": 8,
      "max": 24,
      "step": 1,
      "units": "px",
      "description": "Search Results Font Size"
   },
   "enable_shutdown": {
      "type": "switch",
      "default": true,
      "description": "Enable Power Actions (Shutdown, Restart, Suspend)"
   },
   "enable_logout": {
      "type": "switch",
      "default": true,
      "description": "Enable Session Actions (Logout, Switch User, Lock Screen)"
   },
   "thousand_separator": {
      "type": "combobox",
      "default": "comma",
      "options": {
         "Comma (,)": "comma",
         "Dot (.)": "dot"
      },
      "description": "Thousand Separator"
   },
   "script_prefix": {
      "type": "entry",
      "default": "sh",
      "description": "Trigger word for script runner"
   },
   "script_paths": {
      "type": "entry",
      "default": "~/scripts",
      "description": "Directories to search for scripts"
   },
   "terminal_app": {
      "type": "entry",
      "default": "x-terminal-emulator -e",
      "description": "Terminal execution command"
   }
}
