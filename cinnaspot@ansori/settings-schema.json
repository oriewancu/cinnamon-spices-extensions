{
    "header_general": { "type": "header", "description": "General Settings" },
    "keybinding": { "type": "keybinding", "default": "<Super>space", "description": "Spotlight Keyboard Shortcut" },
    "custom_placeholder": { "type": "entry", "default": "Search apps, settings, commands, calc...", "description": "Search Placeholder Text" },
    "max_results": { "type": "spinbutton", "default": 8, "min": 1, "max": 20, "step": 1, "units": "items", "description": "Max Search Results" },

    "header_windows": { "type": "header", "description": "Opened Windows Sidebar" },
    "show_opened_windows": { "type": "switch", "default": true, "description": "Show Opened Windows" },
    "max_window_results": { "type": "spinbutton", "default": 5, "min": 1, "max": 20, "step": 1, "units": "items", "description": "Max Window Results" },
    "window_font_size": { "type": "spinbutton", "default": 11, "min": 8, "max": 20, "step": 1, "units": "px", "description": "Opened Windows Font Size" },

    "header_sysinfo": { "type": "header", "description": "System Information Sidebar" },
    "show_system_info": { "type": "switch", "default": false, "description": "Show System Info (Right Sidebar)" },
    "disk_path": { "type": "entry", "default": "/", "description": "Disk Partition Path (e.g., / or /home)" },

    "header_appearance": { "type": "header", "description": "Appearance & Results" },
    "theme": { 
        "type": "combobox", 
        "default": "dark", 
        "options": { "Dark": "dark", "Light": "light" }, 
        "description": "Spotlight Theme" 
    },
    "bg_opacity": {
        "type": "scale",
        "default": 95,
        "min": 10,
        "max": 100,
        "step": 1,
        "description": "Panel Background Opacity (%)"
    },
    "result_font_size": { "type": "spinbutton", "default": 14, "min": 8, "max": 24, "step": 1, "units": "px", "description": "Search Results Font Size" },

    "header_session": { "type": "header", "description": "System Actions" },
    "enable_shutdown": { "type": "switch", "default": true, "description": "Enable Power Actions (Shutdown, Restart, Suspend)" },
    "enable_logout": { "type": "switch", "default": true, "description": "Enable Session Actions (Logout, Switch User, Lock Screen)" },

    "header_calc": { "type": "header", "description": "Calculator Settings" },
    "thousand_separator": { 
        "type": "combobox", 
        "default": "comma", 
        "options": { "Comma (,)" : "comma", "Dot (.)" : "dot" }, 
        "description": "Thousand Separator" 
    },

    "header_scripts": { "type": "header", "description": "Script Runner Settings" },
    "script_prefix": { "type": "entry", "default": "sh", "description": "Trigger word for script runner" },
    "script_paths": { "type": "entry", "default": "~/scripts", "description": "Directories to search for scripts" },
    "terminal_app": { "type": "entry", "default": "x-terminal-emulator -e", "description": "Terminal execution command" }
}